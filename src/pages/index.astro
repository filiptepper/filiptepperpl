---
import Layout from "../layouts/Layout.astro";
import TravelCard from "../components/TravelCard.astro";
---

<Layout title="Filip Tepper" description="Personal website of Filip Tepper">
    <!-- Hero Intro Section -->
    <section class="space-y-2">
        <h1
            class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
        >
            Hi, I'm Filip. 👋
        </h1>
        <p class="text-base text-slate-600 font-normal leading-relaxed">
            Site Reliability Engineering Manager at Netflix.
        </p>
    </section>

    <!-- Links & Platforms Section -->
    <section id="links" class="space-y-3">
        <h2
            class="text-[11px] font-mono text-slate-400 uppercase tracking-wider"
        >
            Connect
        </h2>

        <div class="flex flex-col space-y-2 text-xs font-medium">
            <!-- YouTube -->
            <a
                href="https://youtube.com/@FilipTepperYT"
                target="_blank"
                rel="noopener"
                class="py-1.5 flex items-center justify-between group text-slate-600 hover:text-slate-900 transition-colors"
            >
                <span
                    class="group-hover:translate-x-0.5 transition-transform"
                    >YouTube</span
                >
                <span
                    class="font-mono text-[11px] text-slate-400 group-hover:text-slate-600"
                    >@FilipTepperYT</span
                >
            </a>

            <!-- GitHub -->
            <a
                href="https://github.com/filiptepper"
                target="_blank"
                rel="noopener"
                class="py-1.5 flex items-center justify-between group text-slate-600 hover:text-slate-900 transition-colors"
            >
                <span
                    class="group-hover:translate-x-0.5 transition-transform"
                    >GitHub</span
                >
                <span
                    class="font-mono text-[11px] text-slate-400 group-hover:text-slate-600"
                    >@filiptepper</span
                >
            </a>

            <!-- LinkedIn -->
            <a
                href="https://linkedin.com/in/filiptepper"
                target="_blank"
                rel="noopener"
                class="py-1.5 flex items-center justify-between group text-slate-600 hover:text-slate-900 transition-colors"
            >
                <span
                    class="group-hover:translate-x-0.5 transition-transform"
                    >LinkedIn</span
                >
                <span
                    class="font-mono text-[11px] text-slate-400 group-hover:text-slate-600"
                    >in/filiptepper</span
                >
            </a>

            <!-- Goodreads -->
            <a
                href="https://www.goodreads.com/user/show/4096051-filip-tepper"
                target="_blank"
                rel="noopener"
                class="py-1.5 flex items-center justify-between group text-slate-600 hover:text-slate-900 transition-colors"
            >
                <span
                    class="group-hover:translate-x-0.5 transition-transform"
                    >Goodreads</span
                >
                <span
                    class="font-mono text-[11px] text-slate-400 group-hover:text-slate-600"
                    >filip-tepper</span
                >
            </a>

            <!-- Email -->
            <button
                onclick="copyEmail(this)"
                class="py-1.5 flex items-center justify-between group text-slate-600 hover:text-slate-900 transition-colors text-left w-full cursor-pointer"
            >
                <span
                    class="group-hover:translate-x-0.5 transition-transform"
                    >filip@tepper.pl</span
                >
                <span
                    class="font-mono text-[11px] text-slate-400 group-hover:text-slate-600 email-btn-text"
                    >copy</span
                >
            </button>
        </div>
    </section>

    <!-- Travel Section -->
    <section id="travel" class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
            <h2
                class="text-[11px] font-mono text-slate-400 uppercase tracking-wider"
            >
                Travel Logs
            </h2>
        </div>

        <TravelCard
            title="North Sea to North Atlantic"
            description="Summer journey across Hamburg, Shetland Islands, and Iceland's fjords."
            href="/travel/germany-scotland-iceland-2026"
            imageSrc="/images/germany-scotland-iceland-2026/IMG_6833.jpg"
            imageAlt="Germany, Scotland & Iceland 2026"
            date="Jul–Aug 2026"
            badge="Germany · Scotland · Iceland"
        />
    </section>
</Layout>
